{
  "name": "dsh-api-cost",
  "version": "0.1.0",
  "description": "API cost tracker for DeepSeek Harness: per-chat token cost from real API usage, configurable prices per 1M tokens (input/output/cache), currency + language selectors, and live exchange rates from a free open source.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "cost",
    "billing",
    "api"
  ],
  "homepage": "https://github.com/<your-username>/dsh-api-cost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-username>/dsh-api-cost.git"
  },
  "bugs": {
    "url": "https://github.com/<your-username>/dsh-api-cost/issues"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
